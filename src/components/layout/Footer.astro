---
const currentYear = new Date().getFullYear();

const footerLinks = [
  {
    title: "Programs",
    links: [
      { label: "Diploma (DCA-AI)", href: "/programs/dca-ai" },
      { label: "Post Graduate (PGDCA-AI)", href: "/programs/pgdca-ai" },
      { label: "AI Professional Cert", href: "/programs/ai-professional-cert" },
      { label: "Curriculum Overview", href: "/curriculum" },
      { label: "All Programs", href: "/programs" }
    ]
  },
  {
    title: "Admissions",
    links: [
      { label: "Overview", href: "/admissions" },
      { label: "Tuition & Fees", href: "/admissions#fees" },
      { label: "How to Apply", href: "/admissions#apply" },
      { label: "FAQs", href: "/admissions#faq" }
    ]
  },
  {
    title: "Academy",
    links: [
      { label: "About Us", href: "/about" },
      { label: "Methodology", href: "/about#methodology" },
      { label: "Contact Support", href: "/contact" },
      { label: "Careers", href: "/about" }
    ]
  }
];
---

<footer class="border-t border-white/5 bg-brand-bg relative z-10 pt-16 pb-8">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-12 pb-12 border-b border-white/5">
      
      <!-- Company Branding Info -->
      <div class="lg:col-span-2 space-y-6">
        <a href="/" class="flex items-center space-x-2 group">
          <div class="w-8 h-8 flex items-center justify-center rounded bg-gradient-to-br from-brand-primary to-brand-secondary text-white font-extrabold text-sm shadow-md">
            J
          </div>
          <span class="font-sans font-extrabold tracking-wider text-md text-white leading-tight">
            JAI AI AXOM<span class="text-brand-secondary font-light block text-[9px] tracking-widest uppercase">Future Skills Academy</span>
          </span>
        </a>
        <p class="text-sm text-brand-text-muted leading-relaxed max-w-sm">
          India's most modern AI computer institute preparing students for Jobs, Freelancing, and Entrepreneurship through hands-on automation, coding, and productivity courses.
        </p>
        <!-- Social Icons -->
        <div class="flex items-center space-x-4">
          <a href="#" class="text-brand-text-muted hover:text-white transition-colors" aria-label="Twitter">
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/></svg>
          </a>
          <a href="#" class="text-brand-text-muted hover:text-white transition-colors" aria-label="LinkedIn">
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.779-1.75-1.75s.784-1.75 1.75-1.75 1.75.779 1.75 1.75-.784 1.75-1.75 1.75zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
          </a>
          <a href="#" class="text-brand-text-muted hover:text-white transition-colors" aria-label="GitHub">
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
          </a>
        </div>
      </div>

      <!-- Quick Links Columns -->
      {footerLinks.map(column => (
        <div class="space-y-4">
          <h4 class="text-xs font-semibold text-white tracking-wider uppercase">
            {column.title}
          </h4>
          <ul class="space-y-2">
            {column.links.map(link => (
              <li>
                <a href={link.href} class="text-sm text-brand-text-muted hover:text-white transition-colors">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}

      <!-- Newsletter Box -->
      <div class="space-y-4">
        <h4 class="text-xs font-semibold text-white tracking-wider uppercase">
          Stay Updated
        </h4>
        <p class="text-sm text-brand-text-muted">
          Subscribe to get program announcements and AI workshop guides.
        </p>
        <form class="space-y-2" onsubmit="event.preventDefault(); alert('Subscribed!')">
          <input
            type="email"
            required
            placeholder="Enter your email"
            class="w-full px-3 py-2 text-sm bg-white/5 border border-white/10 rounded-lg text-white focus:outline-none focus:border-brand-secondary transition-colors"
          />
          <button
            type="submit"
            class="w-full px-3 py-2 text-sm text-center font-medium text-white bg-gradient-to-r from-brand-primary to-brand-secondary rounded-lg hover:brightness-110 active:brightness-95 transition-all cursor-pointer"
          >
            Subscribe
          </button>
        </form>
      </div>

    </div>

    <!-- Bottom Metadata -->
    <div class="flex flex-col sm:flex-row items-center justify-between pt-8 text-xs text-brand-text-muted space-y-4 sm:space-y-0">
      <p>&copy; {currentYear} AI Academy. All rights reserved.</p>
      <div class="flex items-center space-x-6">
        <a href="#" class="hover:text-white transition-colors">Privacy Policy</a>
        <a href="#" class="hover:text-white transition-colors">Terms of Service</a>
        <a href="/contact" class="hover:text-white transition-colors">Contact Support</a>
      </div>
    </div>

  </div>
</footer>
