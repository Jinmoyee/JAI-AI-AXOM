---
const base = import.meta.env.BASE_URL;
const navItems = [
  { label: 'Home', href: base || '/' },
  { label: 'Curriculum', href: `${base}/curriculum` },
  { label: 'Programs', href: `${base}/programs` },
  { label: 'Admissions', href: `${base}/admissions` },
  { label: 'About', href: `${base}/about` },
  { label: 'Contact', href: `${base}/contact` }
];

const { currentPath = Astro.url.pathname } = Astro.props;
---

<!-- Desktop Navigation -->
<nav class="hidden md:flex items-center space-x-8">
  {navItems.map(item => {
    const isActive = item.href === base
      ? currentPath === base
      : currentPath.startsWith(item.href);
    return (
      <a 
        href={item.href} 
        class={`relative py-2 text-sm font-medium transition-all duration-300 hover:text-white tracking-wide ${isActive ? 'text-white font-semibold' : 'text-brand-text-muted'}`}
      >
        {item.label}
        {isActive && (
          <span class="absolute bottom-0 left-0 right-0 h-0.5 bg-gradient-to-r from-brand-primary to-brand-secondary rounded-full" />
        )}
      </a>
    )
  })}
</nav>

<!-- Mobile Navigation Drawer Items -->
<div class="hidden" id="mobile-nav-items-data">
  {JSON.stringify(navItems)}
</div>
