---
import Nav from './Nav.astro';
import Button from '../ui/Button.astro';

const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;
---

<!-- Accreditation Top Bar -->
  <div class="w-full bg-gradient-to-r from-brand-primary/10 via-brand-secondary/10 to-brand-primary/10 border-b border-white/5 py-1.5 px-4 text-center flex flex-wrap items-center justify-center gap-3 text-[10px] text-brand-text-muted">
    <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-green-500/10 border border-green-500/20 text-green-400 font-semibold">
      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
      ISO Approved
    </span>
    <span class="text-white/20">|</span>
    <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-blue-500/10 border border-blue-500/20 text-blue-400 font-semibold">
      <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2L3 7l9 5 9-5-9-5zM3 17l9 5 9-5M3 12l9 5 9-5"/></svg>
      Government Verified
    </span>
    <span class="text-white/20">|</span>
    <span>Affiliated with <a href="https://mipeonline.in" target="_blank" rel="noopener" class="text-brand-secondary hover:underline font-medium">Mighty Tech Institute</a></span>
  </div>

<header class="sticky top-0 z-50 w-full glass-nav transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Logo Branding -->
      <a href={base} class="flex items-center space-x-2 group">
        <div class="relative w-9 h-9 flex items-center justify-center rounded-lg bg-gradient-to-br from-brand-primary to-brand-secondary text-white font-extrabold text-lg shadow-lg shadow-brand-primary/20 group-hover:scale-105 transition-transform">
          A
          <div class="absolute inset-0 rounded-lg bg-gradient-to-br from-brand-primary to-brand-secondary blur opacity-50 -z-10 group-hover:opacity-100 transition-opacity"></div>
        </div>
        <span class="font-sans font-extrabold tracking-wider text-lg text-white group-hover:text-brand-secondary transition-colors leading-tight">
          Assam Cognexa Institute<span class="text-brand-secondary font-light block text-[10px] tracking-widest uppercase">Future Skills Academy</span>
          <span class="text-[9px] font-normal text-brand-text-muted tracking-normal block">
            <a href="https://mipeonline.in" target="_blank" rel="noopener" class="hover:text-brand-secondary transition-colors">Affiliated · MightyTech</a>
          </span>
        </span>
      </a>

      <!-- Desktop Nav -->
      <Nav currentPath={currentPath} />

      <!-- CTA Button Desktop -->
      <div class="hidden md:flex items-center space-x-4">
        <Button href={`${base}/admissions`} variant="outline" size="sm">
          Apply Now
        </Button>
      </div>

      <!-- Hamburger Menu Mobile Toggle -->
      <div class="flex md:hidden">
        <button
          type="button"
          id="mobile-menu-toggle"
          class="inline-flex items-center justify-center p-2 rounded-lg text-brand-text-muted hover:text-white hover:bg-white/5 focus:outline-none transition-colors"
          aria-controls="mobile-menu"
          aria-expanded="false"
        >
          <span class="sr-only">Open main menu</span>
          <svg class="h-6 w-6" id="menu-icon-closed" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg class="h-6 w-6 hidden" id="menu-icon-open" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Menu Drawer (hidden by default) -->
  <div class="md:hidden hidden border-t border-white/5 bg-brand-bg/95 backdrop-blur-xl" id="mobile-menu">
    <div class="px-4 pt-2 pb-6 space-y-3">
      <a href={base} class={`block px-3 py-2.5 rounded-lg text-base font-medium transition-all ${currentPath === base ? 'bg-white/10 text-white font-semibold' : 'text-brand-text-muted hover:bg-white/5 hover:text-white'}`}>
        Home
      </a>
      <a href={`${base}/curriculum`} class={`block px-3 py-2.5 rounded-lg text-base font-medium transition-all ${currentPath.startsWith(`${base}/curriculum`) ? 'bg-white/10 text-white font-semibold' : 'text-brand-text-muted hover:bg-white/5 hover:text-white'}`}>
        Curriculum
      </a>
      <a href={`${base}/programs`} class={`block px-3 py-2.5 rounded-lg text-base font-medium transition-all ${currentPath.startsWith(`${base}/programs`) ? 'bg-white/10 text-white font-semibold' : 'text-brand-text-muted hover:bg-white/5 hover:text-white'}`}>
        Programs
      </a>
      <a href={`${base}/admissions`} class={`block px-3 py-2.5 rounded-lg text-base font-medium transition-all ${currentPath.startsWith(`${base}/admissions`) ? 'bg-white/10 text-white font-semibold' : 'text-brand-text-muted hover:bg-white/5 hover:text-white'}`}>
        Admissions
      </a>
      <a href={`${base}/about`} class={`block px-3 py-2.5 rounded-lg text-base font-medium transition-all ${currentPath.startsWith(`${base}/about`) ? 'bg-white/10 text-white font-semibold' : 'text-brand-text-muted hover:bg-white/5 hover:text-white'}`}>
        About
      </a>
      <a href={`${base}/contact`} class={`block px-3 py-2.5 rounded-lg text-base font-medium transition-all ${currentPath.startsWith(`${base}/contact`) ? 'bg-white/10 text-white font-semibold' : 'text-brand-text-muted hover:bg-white/5 hover:text-white'}`}>
        Contact
      </a>
      <div class="pt-4 px-3">
        <Button href={`${base}/admissions`} variant="primary" block>
          Apply Now
        </Button>
      </div>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const closedIcon = document.getElementById('menu-icon-closed');
  const openIcon = document.getElementById('menu-icon-open');

  if (toggleBtn && mobileMenu && closedIcon && openIcon) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      
      // Toggle menu visibility
      mobileMenu.classList.toggle('hidden');
      
      // Update icons
      closedIcon.classList.toggle('hidden');
      openIcon.classList.toggle('hidden');
      
      // Update state
      toggleBtn.setAttribute('aria-expanded', (!isExpanded).toString());
    });
  }
</script>
