---
import Nav from './Nav.astro';
import Button from '../ui/Button.astro';

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 w-full glass-nav transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Logo Branding -->
      <a href="/" class="flex items-center space-x-2 group">
        <div class="relative w-9 h-9 flex items-center justify-center rounded-lg bg-gradient-to-br from-brand-primary to-brand-secondary text-white font-extrabold text-lg shadow-lg shadow-brand-primary/20 group-hover:scale-105 transition-transform">
          J
          <div class="absolute inset-0 rounded-lg bg-gradient-to-br from-brand-primary to-brand-secondary blur opacity-50 -z-10 group-hover:opacity-100 transition-opacity"></div>
        </div>
        <span class="font-sans font-extrabold tracking-wider text-lg text-white group-hover:text-brand-secondary transition-colors leading-tight">
          JAI AI AXOM<span class="text-brand-secondary font-light block text-[10px] tracking-widest uppercase">Future Skills Academy</span>
        </span>
      </a>

      <!-- Desktop Nav -->
      <Nav currentPath={currentPath} />

      <!-- CTA Button Desktop -->
      <div class="hidden md:flex items-center space-x-4">
        <Button href="/admissions" variant="outline" size="sm">
          Apply Now
        </Button>
      </div>

      <!-- Hamburger Menu Mobile Toggle -->
      <div class="flex md:hidden">
        <button
          type="button"
          id="mobile-menu-toggle"
          class="inline-flex items-center justify-center p-2 rounded-lg text-brand-text-muted hover:text-white hover:bg-white/5 focus:outline-none transition-colors"
          aria-controls="mobile-menu"
          aria-expanded="false"
        >
          <span class="sr-only">Open main menu</span>
          <svg class="h-6 w-6" id="menu-icon-closed" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg class="h-6 w-6 hidden" id="menu-icon-open" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Menu Drawer (hidden by default) -->
  <div class="md:hidden hidden border-t border-white/5 bg-brand-bg/95 backdrop-blur-xl" id="mobile-menu">
    <div class="px-4 pt-2 pb-6 space-y-3">
      <a href="/" class={`block px-3 py-2.5 rounded-lg text-base font-medium transition-all ${currentPath === '/' ? 'bg-white/10 text-white font-semibold' : 'text-brand-text-muted hover:bg-white/5 hover:text-white'}`}>
        Home
      </a>
      <a href="/curriculum" class={`block px-3 py-2.5 rounded-lg text-base font-medium transition-all ${currentPath.startsWith('/curriculum') ? 'bg-white/10 text-white font-semibold' : 'text-brand-text-muted hover:bg-white/5 hover:text-white'}`}>
        Curriculum
      </a>
      <a href="/programs" class={`block px-3 py-2.5 rounded-lg text-base font-medium transition-all ${currentPath.startsWith('/programs') ? 'bg-white/10 text-white font-semibold' : 'text-brand-text-muted hover:bg-white/5 hover:text-white'}`}>
        Programs
      </a>
      <a href="/admissions" class={`block px-3 py-2.5 rounded-lg text-base font-medium transition-all ${currentPath.startsWith('/admissions') ? 'bg-white/10 text-white font-semibold' : 'text-brand-text-muted hover:bg-white/5 hover:text-white'}`}>
        Admissions
      </a>
      <a href="/about" class={`block px-3 py-2.5 rounded-lg text-base font-medium transition-all ${currentPath.startsWith('/about') ? 'bg-white/10 text-white font-semibold' : 'text-brand-text-muted hover:bg-white/5 hover:text-white'}`}>
        About
      </a>
      <a href="/contact" class={`block px-3 py-2.5 rounded-lg text-base font-medium transition-all ${currentPath.startsWith('/contact') ? 'bg-white/10 text-white font-semibold' : 'text-brand-text-muted hover:bg-white/5 hover:text-white'}`}>
        Contact
      </a>
      <div class="pt-4 px-3">
        <Button href="/admissions" variant="primary" block>
          Apply Now
        </Button>
      </div>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const closedIcon = document.getElementById('menu-icon-closed');
  const openIcon = document.getElementById('menu-icon-open');

  if (toggleBtn && mobileMenu && closedIcon && openIcon) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      
      // Toggle menu visibility
      mobileMenu.classList.toggle('hidden');
      
      // Update icons
      closedIcon.classList.toggle('hidden');
      openIcon.classList.toggle('hidden');
      
      // Update state
      toggleBtn.setAttribute('aria-expanded', (!isExpanded).toString());
    });
  }
</script>
