---

<div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
  {modules.map((mod) => (
    <div class={`group relative glass-card border ${mod.border} rounded-2xl p-6 flex flex-col hover:-translate-y-1 transition-all duration-300 shadow-lg ${mod.glow} hover:shadow-xl`}>
      
      <!-- Header -->
      <div class="flex items-start justify-between mb-4">
        <div class={`text-5xl font-black bg-gradient-to-br ${mod.color} bg-clip-text text-transparent leading-none select-none`}>
          {mod.num}
        </div>
        <span class={`text-[10px] font-bold px-2 py-1 rounded-full bg-gradient-to-r ${mod.color} text-white shrink-0 ml-2 mt-1`}>
          {mod.tag}
        </span>
      </div>

      <!-- Title -->
      <div class="mb-4">
        <h3 class="text-base font-bold text-white font-sans leading-snug">
          {mod.title}
        </h3>
        <p class={`text-xs mt-1 bg-gradient-to-r ${mod.color} bg-clip-text text-transparent font-semibold`}>
          {mod.subtitle}
        </p>
      </div>

      <!-- Features -->
      <ul class="space-y-2 flex-1">
        {mod.features.map(feature => (
          <li class="flex items-start gap-2 text-xs text-brand-text-muted">
            <span class={`mt-0.5 shrink-0 w-4 h-4 rounded-full bg-gradient-to-br ${mod.color} flex items-center justify-center text-[8px] text-white font-bold`}>✓</span>
            <span class="leading-relaxed">{feature}</span>
          </li>
        ))}
      </ul>

    </div>
  ))}
</div>
