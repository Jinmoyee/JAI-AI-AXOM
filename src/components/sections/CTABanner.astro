---
import Button from '../ui/Button.astro';

const base = import.meta.env.BASE_URL;
---

<section class="py-20 bg-brand-bg relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
    
    <!-- Outer Glow Wrap -->
    <div class="relative bg-gradient-to-r from-brand-primary/20 via-indigo-950/40 to-brand-secondary/20 border border-brand-primary/25 rounded-2xl p-8 md:p-16 text-center overflow-hidden">
      <!-- Glow Elements in Banner -->
      <div class="absolute -top-24 -left-24 w-48 h-48 bg-brand-primary/30 rounded-full blur-[60px] pointer-events-none"></div>
      <div class="absolute -bottom-24 -right-24 w-48 h-48 bg-brand-secondary/30 rounded-full blur-[60px] pointer-events-none"></div>

      <div class="max-w-3xl mx-auto space-y-8 relative z-10">
        <!-- Badge -->
        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold tracking-wider text-brand-secondary bg-brand-secondary/10 uppercase">
          Cohort Enrollment Open
        </span>

        <!-- Title -->
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white font-sans tracking-tight leading-tight">
          Ready to Lead in the Age of AI?
        </h2>

        <!-- Description -->
        <p class="text-brand-text-muted text-base sm:text-lg leading-relaxed max-w-2xl mx-auto">
          Enroll in our upcoming cohort to master automation workflows, Python programming, and advanced computer applications supercharged with Generative AI tools.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-wrap justify-center gap-4 pt-4">
          <Button href={`${base}/admissions`} variant="primary" size="lg">
            Apply Online Now
          </Button>
          <Button href={`${base}/contact`} variant="outline" size="lg">
            Contact Admissions
          </Button>
        </div>

        <!-- Meta info -->
        <p class="text-xs text-brand-text-muted">
          Need clarification? Schedule a call with our career advisors at <a href={`${base}/contact`} class="text-white hover:text-brand-secondary transition-colors underline">contact support</a>.
        </p>
      </div>

    </div>

  </div>
</section>
