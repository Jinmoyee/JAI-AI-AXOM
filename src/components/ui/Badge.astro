---
interface Props {
  text: string;
  variant?: 'primary' | 'secondary' | 'accent' | 'outline';
  size?: 'sm' | 'md';
}

const { 
  text, 
  variant = 'primary', 
  size = 'md' 
} = Astro.props;

const variantStyles = {
  primary: 'bg-brand-primary/10 text-brand-primary-light border border-brand-primary/20',
  secondary: 'bg-brand-secondary/10 text-brand-secondary border border-brand-secondary/20',
  accent: 'bg-brand-accent/10 text-brand-accent border border-brand-accent/20',
  outline: 'bg-white/5 text-brand-text border border-white/10 hover:border-white/20 transition-colors'
};

const sizeStyles = {
  sm: 'px-2 py-0.5 text-[10px] font-semibold tracking-wider uppercase',
  md: 'px-2.5 py-1 text-xs font-semibold tracking-wide'
};
---

<span class={`inline-flex items-center rounded-full font-sans select-none ${variantStyles[variant]} ${sizeStyles[size]}`}>
  {text}
</span>
