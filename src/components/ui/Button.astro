---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'outline' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  block?: boolean;
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  id?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  block = false,
  type = 'button',
  class: className = '',
  id,
  ...rest
} = Astro.props;

const baseStyles = 'inline-flex items-center justify-center font-semibold rounded-lg font-sans transition-all duration-300 active:scale-[0.98] cursor-pointer';

const variantStyles = {
  primary: 'bg-gradient-to-r from-brand-primary via-indigo-600 to-brand-secondary text-white shadow-lg shadow-brand-primary/10 hover:shadow-brand-primary/20 hover:brightness-110 hover:-translate-y-0.5',
  secondary: 'bg-brand-secondary text-brand-bg hover:bg-brand-secondary/90 hover:shadow-lg hover:shadow-brand-secondary/15',
  outline: 'border border-white/10 hover:border-brand-secondary/50 text-white hover:bg-brand-secondary/5',
  ghost: 'text-brand-text-muted hover:text-white hover:bg-white/5'
};

const sizeStyles = {
  sm: 'px-3 py-1.5 text-xs',
  md: 'px-5 py-2.5 text-sm',
  lg: 'px-7 py-3 text-base'
};

const widthStyle = block ? 'w-full' : '';

const finalClass = `${baseStyles} ${variantStyles[variant]} ${sizeStyles[size]} ${widthStyle} ${className}`;
---

{
  href ? (
    <a href={href} class={finalClass} id={id} {...rest}>
      <slot />
    </a>
  ) : (
    <button type={type} class={finalClass} id={id} {...rest}>
      <slot />
    </button>
  )
}
