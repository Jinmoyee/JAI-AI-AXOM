---
import BaseLayout from '../layouts/BaseLayout.astro';
import Badge from '../components/ui/Badge.astro';
import Button from '../components/ui/Button.astro';

const steps = [
  {
    num: "01",
    title: "Choose Program",
    desc: "Review our course catalog (DCA, PGDCA, Certificates) and identify the track that matches your learning goals."
  },
  {
    num: "02",
    title: "Apply Online",
    desc: "Complete the digital application form below, outlining your qualifications and software interest."
  },
  {
    num: "03",
    title: "Advisor Interview",
    desc: "Have a 15-minute alignment call with a technical advisor to confirm eligibility and discuss schedules."
  },
  {
    num: "04",
    title: "Reserve Seat",
    desc: "Confirm enrollment, select installment plans if applicable, and unlock your preparatory lab access."
  }
];

const programFees = [
  { name: "Diploma (DCA-AI)", duration: "6 Months", fee: "$1,800", installment: "$350 / month" },
  { name: "Post Graduate (PGDCA-AI)", duration: "1 Year", fee: "$3,400", installment: "$320 / month" },
  { name: "AI Professional Certificate", duration: "3 Months", fee: "$1,200", installment: "N/A" },
  { name: "Executive AI Business Transformation", duration: "8 Weeks", fee: "$950", installment: "N/A" },
  { name: "AI for Office / Creators / Students", duration: "4-6 Weeks", fee: "$450", installment: "N/A" }
];
---

<BaseLayout title="Admissions - Tuition, Process & Application Form" description="Learn about the admissions process at AI Academy. Find detailed tuition fee charts, installment options, and submit your online enrollment application directly.">
  
  <section class="relative py-20 overflow-hidden bg-brand-bg">
    <!-- Glow elements -->
    <div class="absolute top-1/3 left-1/4 -translate-x-1/2 -translate-y-1/2 w-96 h-96 bg-brand-primary/10 rounded-full blur-[120px] pointer-events-none -z-10"></div>
    <div class="absolute bottom-10 right-1/4 translate-x-1/2 translate-y-1/2 w-[400px] h-[400px] bg-brand-secondary/10 rounded-full blur-[130px] pointer-events-none -z-10"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
      
      <!-- Page Title -->
      <div class="max-w-3xl mb-16 space-y-4">
        <Badge text="ADMISSIONS PROCESS" variant="primary" />
        <h1 class="text-4xl sm:text-5xl font-extrabold text-white tracking-tight font-sans">
          Join the Next AI Cohort
        </h1>
        <p class="text-brand-text-muted text-base sm:text-lg max-w-2xl leading-relaxed">
          Start your transformation. Review tuition structures, installment frameworks, application steps, and apply directly using our digital portal.
        </p>
      </div>

      <!-- Steps Grid -->
      <div class="mb-20">
        <h2 class="text-xl sm:text-2xl font-bold text-white font-sans mb-8 border-b border-white/5 pb-2">
          Admissions Roadmap
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
          {steps.map(step => (
            <div class="glass-card p-6 rounded-xl border border-white/5 relative">
              <span class="absolute top-4 right-4 text-3xl font-extrabold text-white/5 font-sans select-none">{step.num}</span>
              <h3 class="text-base font-bold text-white font-sans mt-4 mb-2">{step.title}</h3>
              <p class="text-xs sm:text-sm text-brand-text-muted leading-relaxed">{step.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Fees Section -->
      <div class="mb-20" id="fees">
        <h2 class="text-xl sm:text-2xl font-bold text-white font-sans mb-8 border-b border-white/5 pb-2">
          Tuition & Installments
        </h2>
        <div class="glass-card rounded-xl border border-white/5 overflow-hidden">
          <div class="overflow-x-auto">
            <table class="w-full text-left text-sm border-collapse">
              <thead>
                <tr class="border-b border-white/10 bg-white/5 text-xs font-semibold uppercase tracking-wider text-brand-text-muted">
                  <th class="py-4 px-6">Program Name</th>
                  <th class="py-4 px-6">Duration</th>
                  <th class="py-4 px-6">Total Fee</th>
                  <th class="py-4 px-6">Installment Plan</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-white/5">
                {programFees.map(prog => (
                  <tr class="hover:bg-white/5 transition-colors">
                    <td class="py-4 px-6 font-semibold text-white">{prog.name}</td>
                    <td class="py-4 px-6 text-brand-text-muted">{prog.duration}</td>
                    <td class="py-4 px-6 font-bold text-brand-secondary">{prog.fee}</td>
                    <td class="py-4 px-6 text-brand-text-muted">{prog.installment}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Form Section -->
      <div class="max-w-4xl mx-auto" id="apply">
        <div class="glass-card glow-border p-8 md:p-12 rounded-xl space-y-8 border-white/10">
          <div class="text-center space-y-2">
            <h2 class="text-2xl sm:text-3xl font-extrabold text-white font-sans">
              Enrollment Application Form
            </h2>
            <p class="text-xs sm:text-sm text-brand-text-muted max-w-md mx-auto">
              Provide your details below. Once submitted, our admissions coordinator will arrange your technical placement review.
            </p>
          </div>

          <form class="space-y-6" onsubmit="event.preventDefault(); alert('Application submitted successfully! Our advising team will contact you shortly.')">
            <!-- Row: Personal Info -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div class="space-y-1">
                <label for="app-name" class="text-xs text-brand-text-muted uppercase tracking-wider block font-semibold">Full Name</label>
                <input
                  type="text"
                  id="app-name"
                  required
                  placeholder="Jane Smith"
                  class="w-full px-3 py-2 text-sm bg-white/5 border border-white/10 rounded-lg text-white focus:outline-none focus:border-brand-secondary transition-colors"
                />
              </div>
              <div class="space-y-1">
                <label for="app-email" class="text-xs text-brand-text-muted uppercase tracking-wider block font-semibold">Email Address</label>
                <input
                  type="email"
                  id="app-email"
                  required
                  placeholder="jane@example.com"
                  class="w-full px-3 py-2 text-sm bg-white/5 border border-white/10 rounded-lg text-white focus:outline-none focus:border-brand-secondary transition-colors"
                />
              </div>
            </div>

            <!-- Row: Phone & Qualification -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div class="space-y-1">
                <label for="app-phone" class="text-xs text-brand-text-muted uppercase tracking-wider block font-semibold">Phone Number</label>
                <input
                  type="tel"
                  id="app-phone"
                  required
                  placeholder="+1 (555) 019-2834"
                  class="w-full px-3 py-2 text-sm bg-white/5 border border-white/10 rounded-lg text-white focus:outline-none focus:border-brand-secondary transition-colors"
                />
              </div>
              <div class="space-y-1">
                <label for="app-edu" class="text-xs text-brand-text-muted uppercase tracking-wider block font-semibold">Highest Qualification</label>
                <select
                  id="app-edu"
                  class="w-full px-3 py-2 text-sm bg-brand-bg border border-white/10 rounded-lg text-white focus:outline-none focus:border-brand-secondary transition-colors"
                >
                  <option value="highschool">High School Diploma (10+2)</option>
                  <option value="undergrad">Bachelor's Degree</option>
                  <option value="postgrad">Master's Degree / Higher</option>
                  <option value="other">Other / Professional background</option>
                </select>
              </div>
            </div>

            <!-- Row: Program selection -->
            <div class="space-y-1">
              <label for="app-program" class="text-xs text-brand-text-muted uppercase tracking-wider block font-semibold">Desired AI Program</label>
              <select
                id="app-program"
                class="w-full px-3 py-2 text-sm bg-brand-bg border border-white/10 rounded-lg text-white focus:outline-none focus:border-brand-secondary transition-colors"
              >
                <option value="dca-ai">Diploma in Computer Applications & AI (6 Months)</option>
                <option value="pgdca-ai">Post Graduate Diploma in Computer Applications & AI (1 Year)</option>
                <option value="ai-professional-cert">AI Professional Certificate (3 Months)</option>
                <option value="ai-office-professionals">AI for Office Professionals (4 Weeks)</option>
                <option value="ai-for-students">AI Essentials for Students (6 Weeks)</option>
                <option value="ai-for-business-owners">AI-Driven Business Transformation (8 Weeks)</option>
                <option value="ai-content-creator">AI for Content Creators & Marketers (6 Weeks)</option>
              </select>
            </div>

            <!-- Statement of Purpose -->
            <div class="space-y-1">
              <label for="app-sop" class="text-xs text-brand-text-muted uppercase tracking-wider block font-semibold">Why do you want to join this program?</label>
              <textarea
                id="app-sop"
                rows="4"
                placeholder="Briefly tell us how mastering computer applications & AI tools fits into your career plans..."
                class="w-full px-3 py-2 text-sm bg-white/5 border border-white/10 rounded-lg text-white focus:outline-none focus:border-brand-secondary transition-colors resize-none"
              ></textarea>
            </div>

            <!-- Submit Button -->
            <div class="pt-4">
              <Button type="submit" variant="primary" block>
                Submit Enrollment Application
              </Button>
            </div>
          </form>
        </div>
      </div>

    </div>
  </section>

</BaseLayout>
