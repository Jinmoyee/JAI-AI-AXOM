---
import BaseLayout from '../layouts/BaseLayout.astro';
import Badge from '../components/ui/Badge.astro';
import Button from '../components/ui/Button.astro';
import CTABanner from '../components/sections/CTABanner.astro';

const base = import.meta.env.BASE_URL;

const outcomes = [
  { icon: "💼", title: "Jobs", desc: "Get hired in IT, admin, data, content, and AI-assisted roles." },
  { icon: "🌐", title: "Freelancing", desc: "Earn online on Upwork, Fiverr, and Toptal with AI skills." },
  { icon: "🚀", title: "Entrepreneurship", desc: "Launch your own AI-powered product, agency, or service." },
  { icon: "🤖", title: "AI Productivity", desc: "Work 10x faster using AI assistants, automation & agents." },
  { icon: "🔗", title: "AI Automation", desc: "Build workflows with Make, Zapier, n8n, and APIs." },
  { icon: "🔬", title: "AI Research", desc: "Use Consensus, NotebookLM, Elicit, and Scite professionally." },
  { icon: "🛠️", title: "AI App Development", desc: "Ship apps using Lovable, Bolt, Replit AI, Bubble, and Glide." },
  { icon: "📈", title: "Career Growth", desc: "Build a LinkedIn presence, portfolio, and personal brand." }
];

const pillars = [
  {
    icon: "🤖",
    title: "AI Integrations in Every Module",
    desc: "We do not teach applications in isolation. Every skill — from basic spreadsheets to Python programming — is taught alongside its AI equivalent (ChatGPT, Copilot, Claude, APIs) to model real modern workspaces."
  },
  {
    icon: "📂",
    title: "Portfolio-First Learning",
    desc: "Students build real deliverables: automated support desks, live AI chatbots, Excel dashboards, marketing campaigns, and AI-generated content. You graduate with proof, not just a certificate."
  },
  {
    icon: "⚡",
    title: "No-Code + Code Hybrid",
    desc: "We teach the best of both worlds: no-code tools (Lovable, Bubble, Zapier) for speed, and Python + SQL + APIs for depth. You can ship projects with or without traditional coding."
  },
  {
    icon: "📈",
    title: "Always Updated Curriculum",
    desc: "AI tools change weekly. Our curriculum is continuously updated to include the latest LLMs, MCP protocols, agent frameworks, and productivity workflows used by professionals today."
  }
];
---

<BaseLayout 
  title="About Assam Cognexa Institute – Mission, Vision & Methodology"
  description="Learn about Assam Cognexa Institute — Future Skills Academy — India's most modern AI computer institute. ISO Approved & Government Verified. Affiliated with Mighty Tech Institute.">
  
  <!-- Hero Section -->
  <section class="relative py-20 overflow-hidden bg-brand-bg">
    <div class="absolute top-1/4 left-1/4 -translate-x-1/2 -translate-y-1/2 w-96 h-96 bg-brand-primary/10 rounded-full blur-[120px] pointer-events-none -z-10"></div>
    
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
      <div class="max-w-3xl space-y-6">
        <Badge text="WHO WE ARE" variant="primary" />
        <h1 class="text-4xl sm:text-5xl font-extrabold text-white tracking-tight font-sans leading-tight">
            Assam Cognexa Institute –
          <span class="bg-gradient-to-r from-brand-primary via-indigo-400 to-brand-secondary bg-clip-text text-transparent">
            Future Skills Academy
          </span>
        </h1>
        <p class="text-lg font-semibold text-white italic border-l-2 border-brand-secondary pl-4">
          "Learn Computers. Master AI. Build Your Career."
        </p>
        <p class="text-base text-brand-text-muted leading-relaxed">
          Assam Cognexa Institute is not a traditional DCA centre. We are India's most forward-thinking computer and AI training institute — built from the ground up to produce professionals who are ready for the jobs, freelance markets, and entrepreneurial opportunities of the AI era.
        </p>
      </div>
    </div>
  </section>

  <!-- Mission Section -->
  <section class="py-16 border-t border-white/5 bg-brand-bg relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        <div class="lg:col-span-6 space-y-6">
          <h2 class="text-2xl sm:text-3xl font-bold text-white font-sans">
            Transforming a Traditional Computer Institute into India's Best AI Academy
          </h2>
          <p class="text-sm sm:text-base text-brand-text-muted leading-relaxed">
            Traditional DCA programs teach outdated workflows. They prepare students for the digital world of 2010, not 2025. Assam Cognexa Institute bridges that gap — combining computer fundamentals, Microsoft Office, and AI productivity into a single, modern, career-focused curriculum.
          </p>
          <p class="text-sm sm:text-base text-brand-text-muted leading-relaxed">
            Our graduates go on to work as AI operations executives, automate entire businesses, build revenue-generating apps without coding, and create freelance income on global platforms — not because we teach theory, but because we teach tools.
          </p>
        </div>
        <div class="lg:col-span-6">
          <div class="glass-card glow-border p-8 rounded-xl space-y-4">
            <h3 class="text-lg font-bold text-white font-sans border-b border-white/5 pb-3">We Prepare Students For</h3>
            <div class="grid grid-cols-2 gap-4">
              {outcomes.map(item => (
                <div class="flex items-start space-x-3">
                  <span class="text-xl">{item.icon}</span>
                  <div>
                    <h4 class="text-sm font-semibold text-white">{item.title}</h4>
                    <p class="text-[11px] text-brand-text-muted mt-0.5 leading-relaxed">{item.desc}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Pillars Section -->
  <section class="py-20 border-t border-white/5 bg-brand-bg relative" id="methodology">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
        <span class="text-xs font-semibold tracking-wider text-brand-secondary uppercase">Teaching Framework</span>
        <h2 class="text-3xl font-extrabold text-white tracking-tight font-sans">
          What Makes Assam Cognexa Institute Different
        </h2>
        <p class="text-brand-text-muted text-sm sm:text-base leading-relaxed">
          Four core principles that separate us from every other computer institute in Assam.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        {pillars.map(pillar => (
          <div class="glass-card p-6 rounded-xl border border-white/5 hover:border-brand-primary/20 transition-colors flex space-x-5 items-start">
            <div class="text-3xl p-3 bg-white/5 rounded-lg w-fit shrink-0">
              {pillar.icon}
            </div>
            <div class="space-y-2">
              <h3 class="text-lg font-bold text-white font-sans">{pillar.title}</h3>
              <p class="text-sm text-brand-text-muted leading-relaxed">{pillar.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== MEET THE TEAM ===== -->
  <section class="py-20 border-t border-white/5 bg-brand-bg relative overflow-hidden">
    <div class="absolute top-1/3 left-1/4 w-96 h-96 bg-brand-primary/5 rounded-full blur-[120px] pointer-events-none"></div>
    <div class="absolute bottom-1/4 right-1/4 w-80 h-80 bg-brand-secondary/5 rounded-full blur-[100px] pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
      <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
        <span class="text-xs font-semibold tracking-wider text-brand-secondary uppercase">Our Team</span>
        <h2 class="text-3xl font-extrabold text-white tracking-tight font-sans">
          Meet the Minds Behind Assam Cognexa Institute
        </h2>
        <p class="text-brand-text-muted text-sm sm:text-base leading-relaxed">
          Industry experts, AI specialists, and educators committed to building India's most modern AI computer institute.
        </p>
      </div>

      <div class="max-w-4xl mx-auto space-y-8">
        <!-- Raju Ahmed -->
        <div class="glass-card glow-border rounded-xl p-6 md:p-8 flex flex-col md:flex-row gap-6 items-start border-white/10">
          <div class="shrink-0 w-24 h-24 md:w-28 md:h-28 rounded-xl bg-gradient-to-br from-brand-primary to-brand-secondary p-0.5">
            <img src={`${base}/images/persons/raju.jpeg`} alt="Raju Ahmed"
              class="w-full h-full rounded-xl object-cover bg-brand-bg"
              onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"
            />
            <div class="hidden w-full h-full rounded-xl bg-brand-bg items-center justify-center text-3xl font-bold text-brand-secondary" aria-hidden="true">RA</div>
          </div>
          <div class="space-y-3 flex-1">
            <div>
              <h3 class="text-xl font-bold text-white font-sans">Raju Ahmed</h3>
              <span class="text-xs font-semibold text-brand-secondary uppercase tracking-wider">Computer Engineer & AI Specialist</span>
            </div>
            <p class="text-sm text-brand-text-muted leading-relaxed">
              Graduate from NEHU with a background in Computer Engineering. Raju brings deep expertise in AI systems, 
              curriculum design, and hands-on training — ensuring every program at Assam Cognexa Institute is industry-relevant and future-ready.
            </p>
          </div>
        </div>

        <!-- Jinmoyee Thakuria -->
        <div class="glass-card glow-border rounded-xl p-6 md:p-8 flex flex-col md:flex-row gap-6 items-start border-white/10">
          <div class="shrink-0 w-24 h-24 md:w-28 md:h-28 rounded-xl bg-gradient-to-br from-brand-primary to-brand-secondary p-0.5">
            <img src={`${base}/images/persons/jinmoyee.png`} alt="Jinmoyee Thakuria"
              class="w-full h-full rounded-xl object-cover bg-brand-bg"
              onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"
            />
            <div class="hidden w-full h-full rounded-xl bg-brand-bg items-center justify-center text-3xl font-bold text-brand-secondary" aria-hidden="true">JT</div>
          </div>
          <div class="space-y-3 flex-1">
            <div>
              <h3 class="text-xl font-bold text-white font-sans">Jinmoyee Thakuria</h3>
              <span class="text-xs font-semibold text-brand-secondary uppercase tracking-wider">AI, ML & Computer Vision | Full-Stack Development | Research & Innovation</span>
            </div>
            <p class="text-sm text-brand-text-muted leading-relaxed">
              Computer Science Graduate with expertise in AI, Machine Learning, Computer Vision, and Full-Stack Development. 
              Jinmoyee drives research and innovation at Assam Cognexa Institute — building cutting-edge AI solutions and shaping the 
              academy's technical vision.
            </p>
          </div>
        </div>

        <!-- Working Professional (Anonymous/Student) -->
        <div class="glass-card glow-border rounded-xl p-6 md:p-8 flex flex-col md:flex-row gap-6 items-start border-white/10">
          <div class="shrink-0 w-24 h-24 md:w-28 md:h-28 rounded-xl bg-gradient-to-br from-brand-primary to-brand-secondary p-0.5">
            <img src={`${base}/images/persons/associate-member.png`} alt="Associate Team Member"
              class="w-full h-full rounded-xl object-cover bg-brand-bg"
              onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"
            />
            <div class="hidden w-full h-full rounded-xl bg-brand-bg items-center justify-center text-3xl font-bold text-brand-secondary" aria-hidden="true">??</div>
          </div>
          <div class="space-y-3 flex-1">
            <div>
              <h3 class="text-xl font-bold text-white font-sans">Associate Team Member</h3>
              <span class="text-xs font-semibold text-brand-secondary uppercase tracking-wider">AI Engineer | NIT Silchar & IIT Madras Alumni</span>
            </div>
            <p class="text-sm text-brand-text-muted leading-relaxed">
              A highly accomplished engineer currently working in the industry. B-Tech from NIT Silchar and M-Tech from IIT Madras — 
              bringing top-tier technical expertise, real-world experience, and advanced AI knowledge to the academy's program development.
              <span class="block mt-2 text-xs italic">(Identity withheld per request — currently employed.)</span>
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Accreditation & Affiliation Section -->
  <section class="py-20 border-t border-white/5 bg-brand-bg relative overflow-hidden" id="accreditation">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[300px] bg-brand-primary/5 rounded-full blur-[120px] pointer-events-none"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">

      <div class="text-center max-w-2xl mx-auto mb-14 space-y-4">
        <span class="text-xs font-semibold tracking-wider text-brand-secondary uppercase">Trust & Recognition</span>
        <h2 class="text-3xl font-extrabold text-white tracking-tight font-sans">
          Accreditations & Affiliations
        </h2>
        <p class="text-brand-text-muted text-sm sm:text-base leading-relaxed">
          Assam Cognexa Institute operates with full regulatory compliance — ISO certified, Government verified, and proudly affiliated with Mighty Tech Institute.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-4xl mx-auto">

        <!-- ISO Card -->
        <div class="glass-card glow-border rounded-xl p-6 border border-green-500/20 hover:border-green-500/40 transition-all duration-300 text-center space-y-4 group">
          <div class="w-14 h-14 mx-auto rounded-full bg-green-500/10 border border-green-500/20 flex items-center justify-center group-hover:scale-110 transition-transform">
            <svg class="w-7 h-7 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <div>
            <h3 class="text-lg font-bold text-white font-sans">ISO Approved</h3>
            <p class="text-sm text-brand-text-muted mt-1 leading-relaxed">
              Our programs and processes meet internationally recognized ISO quality management standards.
            </p>
          </div>
          <span class="inline-block px-3 py-1 rounded-full bg-green-500/10 border border-green-500/20 text-green-400 text-xs font-semibold">Certified</span>
        </div>

        <!-- Government Verified Card -->
        <div class="glass-card glow-border rounded-xl p-6 border border-blue-500/20 hover:border-blue-500/40 transition-all duration-300 text-center space-y-4 group">
          <div class="w-14 h-14 mx-auto rounded-full bg-blue-500/10 border border-blue-500/20 flex items-center justify-center group-hover:scale-110 transition-transform">
            <svg class="w-7 h-7 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 14v3m4-3v3m4-3v3M3 21h18M3 10h18M3 7l9-4 9 4M4 10h16v11H4V10z" />
            </svg>
          </div>
          <div>
            <h3 class="text-lg font-bold text-white font-sans">Government Verified</h3>
            <p class="text-sm text-brand-text-muted mt-1 leading-relaxed">
              Recognized and verified by the Government of India — ensuring credibility and trustworthy certification.
            </p>
          </div>
          <span class="inline-block px-3 py-1 rounded-full bg-blue-500/10 border border-blue-500/20 text-blue-400 text-xs font-semibold">Verified</span>
        </div>

        <!-- Affiliation Card -->
        <div class="glass-card glow-border rounded-xl p-6 border border-brand-secondary/20 hover:border-brand-secondary/40 transition-all duration-300 text-center space-y-4 group">
          <div class="w-14 h-14 mx-auto rounded-full bg-brand-secondary/10 border border-brand-secondary/20 flex items-center justify-center group-hover:scale-110 transition-transform">
            <svg class="w-7 h-7 text-brand-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
            </svg>
          </div>
          <div>
            <h3 class="text-lg font-bold text-white font-sans">Mighty Tech Institute</h3>
            <p class="text-sm text-brand-text-muted mt-1 leading-relaxed">
              Proudly affiliated with Mighty Tech Institute — our academic and industry partner powering curriculum quality.
            </p>
          </div>
          <a href="https://mipeonline.in" target="_blank" rel="noopener" class="inline-block px-3 py-1 rounded-full bg-brand-secondary/10 border border-brand-secondary/20 text-brand-secondary text-xs font-semibold hover:bg-brand-secondary/20 transition-colors">mipeonline.in ↗</a>
        </div>

      </div>
    </div>
  </section>

  <CTABanner />
</BaseLayout>
